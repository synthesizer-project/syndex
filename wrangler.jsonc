{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "synthesizer-data-api",
  "main": "src/worker/entry.js",
  "compatibility_date": "2026-09-04",
  // workers.dev stays enabled as a second entrypoint while
  // data.synthesizer-project.org is young: security products routinely block
  // or TLS-intercept newly registered domains, and the downloader falls back
  // to this hostname when the branded one cannot be reached. Disable it once
  // the domain has aged out of those categories.
  "workers_dev": true,
  "routes": [
    {
      "pattern": "data.synthesizer-project.org",
      "custom_domain": true
    },
    // The portal. The org site is static GitHub Pages, and a Worker route
    // matches before the request reaches the origin, so this path is served
    // from here without Pages knowing about it.
    {
      "pattern": "synthesizer-project.org/syndicate/*",
      "zone_name": "synthesizer-project.org"
    }
  ],
  // The portal's stylesheet and its vendored copy of htmx, built by
  // `npm run build`. Assets are matched before the Worker runs, and nothing
  // in here sits at a /v1 path, so the API cannot be shadowed by one; with
  // no matching asset the request falls through to the Worker, which is
  // every page the portal serves.
  "assets": {
    "directory": "dist/assets"
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "synthesizer-database",
      "database_id": "6504c716-2065-4b31-8618-453ac12a1144",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "synthesizer-data"
    },
    // Contributed files, before anyone has opened them. A separate bucket
    // rather than a prefix of the catalogue's: unvalidated bytes should not
    // share a namespace with the authoritative store, and the credentials
    // the portal mints for a submitter are scoped to this bucket, so they
    // could not reach a published object even if they leaked.
    {
      "binding": "SUBMISSIONS",
      "bucket_name": "synthesizer-submissions"
    }
  ],
  "vars": {
    // Not secrets: an account id and a bucket name. The R2 key, its secret,
    // the API token that mints temporary credentials, the Turnstile secret
    // and the review password are all `wrangler secret put`.
    "SYNTHESIZER_CLOUDFLARE_ACCOUNT_ID": "e86ac0bb0bee64457c144e84d67966ef",
    "SYNTHESIZER_SUBMISSIONS_BUCKET": "synthesizer-submissions"
  }
}
