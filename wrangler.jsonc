{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "synthesizer-data-api",
  "main": "src/worker/index.js",
  "compatibility_date": "2026-09-04",
  // workers.dev stays enabled as a second entrypoint while
  // data.synthesizer-project.org is young: security products routinely block
  // or TLS-intercept newly registered domains, and the downloader falls back
  // to this hostname when the branded one cannot be reached. Disable it once
  // the domain has aged out of those categories.
  "workers_dev": true,
  "routes": [
    {
      "pattern": "data.synthesizer-project.org",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "synthesizer-database",
      "database_id": "6504c716-2065-4b31-8618-453ac12a1144",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "synthesizer-data"
    }
  ]
}
