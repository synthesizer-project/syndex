{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "synthesizer-data-api",
  "main": "src/worker/index.js",
  "compatibility_date": "2026-09-04",
  // The branded hostname is the only public entrypoint: workers.dev is
  // disabled so there is never a second URL for the same catalogue.
  "workers_dev": false,
  "routes": [
    {
      "pattern": "data.synthesizer-project.org",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "synthesizer-database",
      "database_id": "6504c716-2065-4b31-8618-453ac12a1144",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "synthesizer-data"
    }
  ]
}
